rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny everything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Reusable Security Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Pure token check (no get/exists) safe for use inside allow list rules
    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'chwong0529@gmail.com';
    }

    // Full admin check for single-document operations (never called inside allow list)
    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailStr(val) {
      return val is string && val.size() >= 3 && val.size() <= 160;
    }

    function isClientOwner(clientData) {
      return isVerifiedUser() && (
        clientData.ownerUid == request.auth.uid ||
        clientData.email == request.auth.token.email
      );
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap Helpers)
    // -------------------------------------------------------------------------
    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt']) &&
        isValidId(data.uid) &&
        isValidEmailStr(data.email) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidClientDoc(data) {
      return data.keys().hasAll([
          'clientId', 'ownerUid', 'name', 'email', 'phone',
          'taxYear', 'filingCategory', 'jobStatus', 'isLocked',
          'reminderCount', 'latestReminderDraft', 'requiredDocuments',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'clientId', 'ownerUid', 'name', 'email', 'phone',
          'taxYear', 'filingCategory', 'jobStatus', 'isLocked',
          'reminderCount', 'lastReminderSent', 'latestReminderDraft',
          'requiredDocuments', 'createdAt', 'updatedAt'
        ]) &&
        data.clientId is string && data.clientId.size() >= 3 && data.clientId.size() <= 64 &&
        data.clientId.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidId(data.ownerUid) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        isValidEmailStr(data.email) &&
        data.phone is string && data.phone.size() <= 32 &&
        data.taxYear is int && data.taxYear >= 2020 && data.taxYear <= 2035 &&
        data.filingCategory in [
          'Form BE (Salaried)',
          'Form B (Business / Commission)',
          'Form M (Non-Resident)'
        ] &&
        data.jobStatus in ['No Book In', 'Pending Document', 'Book In Can Start'] &&
        data.isLocked is bool &&
        data.reminderCount is int && data.reminderCount >= 0 && data.reminderCount <= 100 &&
        (!('lastReminderSent' in data) || data.lastReminderSent == null || data.lastReminderSent is timestamp) &&
        data.latestReminderDraft is string && data.latestReminderDraft.size() <= 2500 &&
        data.requiredDocuments is list &&
        data.requiredDocuments.size() <= 20 &&
        (data.requiredDocuments.size() == 0 || data.requiredDocuments[0] is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVerificationDoc(data) {
      return data.keys().hasAll([
          'clientId', 'clientOwnerUid', 'clientEmail', 'submittedByUid',
          'recommendedJobStatus', 'automatedReminderDraft',
          'detectedDocuments', 'missingDocuments', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'clientId', 'clientOwnerUid', 'clientEmail', 'submittedByUid',
          'recommendedJobStatus', 'automatedReminderDraft',
          'detectedDocuments', 'missingDocuments', 'createdAt'
        ]) &&
        data.clientId is string && data.clientId.size() >= 3 && data.clientId.size() <= 64 &&
        data.clientId.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidId(data.clientOwnerUid) &&
        isValidEmailStr(data.clientEmail) &&
        isValidId(data.submittedByUid) &&
        data.recommendedJobStatus in ['No Book In', 'Pending Document', 'Book In Can Start'] &&
        data.automatedReminderDraft is string && data.automatedReminderDraft.size() <= 2500 &&
        data.detectedDocuments is list &&
        data.detectedDocuments.size() <= 20 &&
        (data.detectedDocuments.size() == 0 || data.detectedDocuments[0] is map) &&
        data.missingDocuments is list &&
        data.missingDocuments.size() <= 20 &&
        (data.missingDocuments.size() == 0 || data.missingDocuments[0] is string) &&
        data.createdAt is timestamp;
    }

    function isValidReminderDoc(data) {
      return data.keys().hasAll([
          'clientId', 'clientOwnerUid', 'clientEmail', 'sentByUid',
          'stage', 'channel', 'message', 'missingDocuments', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'clientId', 'clientOwnerUid', 'clientEmail', 'sentByUid',
          'stage', 'channel', 'message', 'missingDocuments', 'createdAt'
        ]) &&
        data.clientId is string && data.clientId.size() >= 3 && data.clientId.size() <= 64 &&
        data.clientId.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidId(data.clientOwnerUid) &&
        isValidEmailStr(data.clientEmail) &&
        isValidId(data.sentByUid) &&
        data.stage in ['Initial Outreach', '7-Day Follow-up', 'Missing Doc Alert', 'Ready for Tax Prep'] &&
        data.channel in ['Email', 'WhatsApp', 'Portal'] &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2500 &&
        data.missingDocuments is list &&
        data.missingDocuments.size() <= 20 &&
        (data.missingDocuments.size() == 0 || data.missingDocuments[0] is string) &&
        data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection: /admins/{uid}
    // -------------------------------------------------------------------------
    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidAdminDoc(incoming()) &&
        incoming().uid == uid &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidAdminDoc(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(uid) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: /clients/{clientId}
    // -------------------------------------------------------------------------
    match /clients/{clientId} {
      allow get: if isVerifiedUser() &&
        isValidId(clientId) &&
        (isClientOwner(existing()) || isAdmin());

      allow list: if isBootstrappedAdmin() || (
        isVerifiedUser() &&
        (existing().ownerUid == request.auth.uid || existing().email == request.auth.token.email)
      );

      allow create: if isVerifiedUser() &&
        isValidId(clientId) &&
        incoming().clientId == clientId &&
        isValidClientDoc(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            incoming().ownerUid == request.auth.uid &&
            incoming().email == request.auth.token.email &&
            incoming().isLocked == false &&
            incoming().reminderCount == 0
          ) ||
          isAdmin()
        );

      allow update: if isVerifiedUser() &&
        isValidId(clientId) &&
        isValidClientDoc(incoming()) &&
        incoming().clientId == existing().clientId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Tier 1: Tax firm staff admin
          isAdmin() ||
          // Tier 2: Verified taxpayer submitting verified document updates on an unlocked file
          (
            existing().isLocked == false &&
            incoming().isLocked == false &&
            incoming().ownerUid == existing().ownerUid &&
            isClientOwner(existing()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'requiredDocuments',
              'jobStatus',
              'latestReminderDraft',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(clientId) && isAdmin();

      // -----------------------------------------------------------------------
      // Subcollection: /clients/{clientId}/verifications/{verificationId}
      // -----------------------------------------------------------------------
      match /verifications/{verificationId} {
        allow get: if isVerifiedUser() &&
          isValidId(clientId) &&
          isValidId(verificationId) &&
          (
            isClientOwner(get(/databases/$(database)/documents/clients/$(clientId)).data) ||
            isAdmin()
          );

        allow list: if isBootstrappedAdmin() || (
          isVerifiedUser() &&
          (existing().clientOwnerUid == request.auth.uid || existing().clientEmail == request.auth.token.email)
        );

        allow create: if isVerifiedUser() &&
          isValidId(clientId) &&
          isValidId(verificationId) &&
          isValidVerificationDoc(incoming()) &&
          incoming().clientId == clientId &&
          incoming().submittedByUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/clients/$(clientId)) &&
          (
            isAdmin() ||
            (
              isClientOwner(get(/databases/$(database)/documents/clients/$(clientId)).data) &&
              get(/databases/$(database)/documents/clients/$(clientId)).data.isLocked == false &&
              incoming().clientOwnerUid == get(/databases/$(database)/documents/clients/$(clientId)).data.ownerUid &&
              incoming().clientEmail == get(/databases/$(database)/documents/clients/$(clientId)).data.email
            )
          );

        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(clientId) && isValidId(verificationId) && isAdmin();
      }

      // -----------------------------------------------------------------------
      // Subcollection: /clients/{clientId}/reminders/{reminderId}
      // -----------------------------------------------------------------------
      match /reminders/{reminderId} {
        allow get: if isVerifiedUser() &&
          isValidId(clientId) &&
          isValidId(reminderId) &&
          (
            isClientOwner(get(/databases/$(database)/documents/clients/$(clientId)).data) ||
            isAdmin()
          );

        allow list: if isBootstrappedAdmin() || (
          isVerifiedUser() &&
          (existing().clientOwnerUid == request.auth.uid || existing().clientEmail == request.auth.token.email)
        );

        allow create: if isVerifiedUser() &&
          isValidId(clientId) &&
          isValidId(reminderId) &&
          isValidReminderDoc(incoming()) &&
          incoming().clientId == clientId &&
          incoming().sentByUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/clients/$(clientId)) &&
          isAdmin();

        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(clientId) && isValidId(reminderId) && isAdmin();
      }
    }
  }
}
