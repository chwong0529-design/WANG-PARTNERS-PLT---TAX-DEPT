rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny everything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Reusable Security Primitives & RBAC Helpers
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : 'user';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'chwong0529@gmail.com' ||
        getUserRole(request.auth.uid) == 'administrator'
      );
    }

    function isManager() {
      return isVerifiedUser() && getUserRole(request.auth.uid) == 'manager';
    }

    function isStaffOrManager() {
      return isAdmin() || isManager();
    }

    function isValidId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailStr(val) {
      return val is string && val.size() >= 3 && val.size() <= 160;
    }

    function isClientOwner(clientData) {
      return isVerifiedUser() && (
        clientData.ownerUid == request.auth.uid ||
        clientData.email == request.auth.token.email
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid',
        'email',
        'displayName',
        'role',
        'twoFactorEnabled',
        'twoFactorLocked',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'email',
        'displayName',
        'role',
        'assignedClientId',
        'twoFactorEnabled',
        'twoFactorLocked',
        'twoFactorApprovedUntil',
        'createdAt'
      ]) &&
      isValidId(data.uid) &&
      isValidEmailStr(data.email) &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 120 &&
      data.role in ['administrator', 'manager', 'user'] &&
      (!('assignedClientId' in data) || data.assignedClientId == null || (data.assignedClientId is string && data.assignedClientId.size() <= 64)) &&
      data.twoFactorEnabled is bool &&
      data.twoFactorLocked is bool &&
      (!('twoFactorApprovedUntil' in data) || data.twoFactorApprovedUntil == null || data.twoFactorApprovedUntil is timestamp) &&
      data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
        'timestamp',
        'userId',
        'userEmail',
        'userRole',
        'pageVisited',
        'actionTaken',
        'details'
      ]) &&
      data.keys().hasOnly([
        'timestamp',
        'userId',
        'userEmail',
        'userRole',
        'pageVisited',
        'actionTaken',
        'details'
      ]) &&
      data.timestamp is timestamp &&
      isValidId(data.userId) &&
      isValidEmailStr(data.userEmail) &&
      data.userRole in ['administrator', 'manager', 'user'] &&
      data.pageVisited is string &&
      data.pageVisited.size() >= 1 &&
      data.pageVisited.size() <= 160 &&
      data.actionTaken is string &&
      data.actionTaken.size() >= 1 &&
      data.actionTaken.size() <= 80 &&
      data.details is string &&
      data.details.size() <= 1500;
    }

    function isValidTwoFactorRequest(data) {
      return data.keys().hasAll([
        'requesterUid',
        'requesterEmail',
        'requesterRole',
        'requestType',
        'reason',
        'status',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'requesterUid',
        'requesterEmail',
        'requesterRole',
        'requestType',
        'reason',
        'status',
        'createdAt',
        'reviewedByUid',
        'reviewedByEmail',
        'reviewedAt'
      ]) &&
      isValidId(data.requesterUid) &&
      isValidEmailStr(data.requesterEmail) &&
      data.requesterRole in ['administrator', 'manager', 'user'] &&
      data.requestType in ['DISABLE_2FA', 'RESET_2FA_SECRET', 'CHANGE_2FA_METHOD'] &&
      data.reason is string &&
      data.reason.size() >= 5 &&
      data.reason.size() <= 500 &&
      data.status in ['PENDING', 'APPROVED', 'REJECTED', 'COMPLETED'] &&
      data.createdAt is timestamp &&
      (!('reviewedByUid' in data) || data.reviewedByUid == null || isValidId(data.reviewedByUid)) &&
      (!('reviewedByEmail' in data) || data.reviewedByEmail == null || isValidEmailStr(data.reviewedByEmail)) &&
      (!('reviewedAt' in data) || data.reviewedAt == null || data.reviewedAt is timestamp);
    }

    function isValidSecuritySettings(data) {
      return data.keys().hasAll([
        'require2faForAdminAndManager',
        'updatedByUid',
        'updatedByEmail',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'require2faForAdminAndManager',
        'updatedByUid',
        'updatedByEmail',
        'updatedAt'
      ]) &&
      data.require2faForAdminAndManager is bool &&
      isValidId(data.updatedByUid) &&
      isValidEmailStr(data.updatedByEmail) &&
      data.updatedAt is timestamp;
    }

    function isValidAppConfigSettings(data) {
      return data.keys().hasAll([
        'activeTaxYear',
        'reminderIntervalDays',
        'defaultTemplates',
        'updatedByUid',
        'updatedByEmail',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'activeTaxYear',
        'reminderIntervalDays',
        'defaultTemplates',
        'updatedByUid',
        'updatedByEmail',
        'updatedAt'
      ]) &&
      data.activeTaxYear is int &&
      data.activeTaxYear >= 2020 &&
      data.activeTaxYear <= 2035 &&
      data.reminderIntervalDays is int &&
      data.reminderIntervalDays >= 1 &&
      data.reminderIntervalDays <= 60 &&
      data.defaultTemplates is map &&
      isValidId(data.updatedByUid) &&
      isValidEmailStr(data.updatedByEmail) &&
      data.updatedAt is timestamp;
    }

    function isValidGovernanceChangeRequest(data) {
      return data.keys().hasAll([
        'category',
        'targetCollection',
        'targetDocId',
        'targetLabel',
        'operation',
        'proposedPayload',
        'reason',
        'requestedByUid',
        'requestedByEmail',
        'requestedByRole',
        'status',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'category',
        'targetCollection',
        'targetDocId',
        'targetLabel',
        'operation',
        'proposedPayload',
        'previousSummary',
        'reason',
        'requestedByUid',
        'requestedByEmail',
        'requestedByRole',
        'status',
        'createdAt',
        'reviewedByUid',
        'reviewedByEmail',
        'reviewedAt',
        'reviewNote'
      ]) &&
      data.category in ['CLIENT_DB_CHANGE', 'APP_CONFIG_CHANGE', 'ROLE_ELEVATION', 'TWO_FACTOR_CHANGE'] &&
      data.targetCollection in ['clients', 'system_settings', 'users'] &&
      isValidId(data.targetDocId) &&
      data.targetLabel is string &&
      data.targetLabel.size() >= 1 &&
      data.targetLabel.size() <= 200 &&
      data.operation in ['CREATE', 'UPDATE', 'DELETE'] &&
      data.proposedPayload is map &&
      (!('previousSummary' in data) || data.previousSummary == null || (data.previousSummary is string && data.previousSummary.size() <= 1000)) &&
      data.reason is string &&
      data.reason.size() >= 10 &&
      data.reason.size() <= 600 &&
      isValidId(data.requestedByUid) &&
      isValidEmailStr(data.requestedByEmail) &&
      data.requestedByRole in ['administrator', 'manager', 'user'] &&
      data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
      data.createdAt is timestamp &&
      (!('reviewedByUid' in data) || data.reviewedByUid == null || isValidId(data.reviewedByUid)) &&
      (!('reviewedByEmail' in data) || data.reviewedByEmail == null || isValidEmailStr(data.reviewedByEmail)) &&
      (!('reviewedAt' in data) || data.reviewedAt == null || data.reviewedAt is timestamp) &&
      (!('reviewNote' in data) || data.reviewNote == null || (data.reviewNote is string && data.reviewNote.size() <= 500));
    }

    // -------------------------------------------------------------------------
    // Collection: /users/{uid}
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isStaffOrManager());
      allow list: if isStaffOrManager();

      allow create: if isVerifiedUser() &&
        isValidId(uid) &&
        request.auth.uid == uid &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().twoFactorEnabled == false &&
        incoming().twoFactorLocked == true &&
        (!('twoFactorApprovedUntil' in incoming()) || incoming().twoFactorApprovedUntil == null) &&
        (
          incoming().role == 'user' ||
          (request.auth.token.email == 'chwong0529@gmail.com' && incoming().role == 'administrator')
        );

      allow update: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        (
          // Action 1: System Administrator update (role assignment, 2FA unlock/lock)
          isAdmin() ||
          // Action 2: Legacy profile 2FA field backfill (defaults locked & disabled)
          (
            request.auth.uid == uid &&
            !('twoFactorLocked' in existing()) &&
            incoming().role == existing().role &&
            incoming().twoFactorEnabled == false &&
            incoming().twoFactorLocked == true &&
            incoming().twoFactorApprovedUntil == null &&
            incoming().diff(existing()).affectedKeys().hasOnly(['twoFactorEnabled', 'twoFactorLocked', 'twoFactorApprovedUntil'])
          ) ||
          // Action 3: Approved single-use 2FA update by owner (must immediately re-lock)
          (
            request.auth.uid == uid &&
            ('twoFactorLocked' in existing()) &&
            existing().twoFactorLocked == false &&
            incoming().role == existing().role &&
            incoming().twoFactorLocked == true &&
            incoming().twoFactorApprovedUntil == null &&
            incoming().diff(existing()).affectedKeys().hasOnly(['twoFactorEnabled', 'twoFactorLocked', 'twoFactorApprovedUntil'])
          )
        );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: /two_factor_requests/{requestId}
    // -------------------------------------------------------------------------
    match /two_factor_requests/{requestId} {
      allow get: if isVerifiedUser() &&
        isValidId(requestId) &&
        (isAdmin() || existing().requesterUid == request.auth.uid);

      allow list: if isAdmin() || (
        isVerifiedUser() &&
        existing().requesterUid == request.auth.uid
      );

      allow create: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidTwoFactorRequest(incoming()) &&
        incoming().requesterUid == request.auth.uid &&
        incoming().requesterEmail.lower() == request.auth.token.email.lower() &&
        incoming().status == 'PENDING' &&
        incoming().createdAt == request.time &&
        (!('reviewedByUid' in incoming()) || incoming().reviewedByUid == null) &&
        (!('reviewedByEmail' in incoming()) || incoming().reviewedByEmail == null) &&
        (!('reviewedAt' in incoming()) || incoming().reviewedAt == null);

      allow update: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidTwoFactorRequest(incoming()) &&
        incoming().requesterUid == existing().requesterUid &&
        incoming().requesterEmail == existing().requesterEmail &&
        incoming().requesterRole == existing().requesterRole &&
        incoming().requestType == existing().requestType &&
        incoming().reason == existing().reason &&
        incoming().createdAt == existing().createdAt &&
        (
          // Action 1: System Administrator approves or rejects a PENDING request
          (
            isAdmin() &&
            existing().status == 'PENDING' &&
            incoming().status in ['APPROVED', 'REJECTED'] &&
            incoming().reviewedByUid == request.auth.uid &&
            incoming().reviewedByEmail.lower() == request.auth.token.email.lower() &&
            incoming().reviewedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedByUid', 'reviewedByEmail', 'reviewedAt'])
          ) ||
          // Action 2: Requester completes an APPROVED 2FA change (terminal state)
          (
            existing().requesterUid == request.auth.uid &&
            existing().status == 'APPROVED' &&
            incoming().status == 'COMPLETED' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status'])
          )
        );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Collection: /change_requests/{requestId} (Unified Governance Queue)
    // -------------------------------------------------------------------------
    match /change_requests/{requestId} {
      allow get: if isVerifiedUser() &&
        isValidId(requestId) &&
        (isAdmin() || existing().requestedByUid == request.auth.uid);

      allow list: if isAdmin() || (
        isVerifiedUser() &&
        existing().requestedByUid == request.auth.uid
      );

      allow create: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidGovernanceChangeRequest(incoming()) &&
        incoming().requestedByUid == request.auth.uid &&
        incoming().requestedByEmail.lower() == request.auth.token.email.lower() &&
        incoming().status == 'PENDING' &&
        incoming().createdAt == request.time &&
        (!('reviewedByUid' in incoming()) || incoming().reviewedByUid == null) &&
        (!('reviewedByEmail' in incoming()) || incoming().reviewedByEmail == null) &&
        (!('reviewedAt' in incoming()) || incoming().reviewedAt == null) &&
        (!('reviewNote' in incoming()) || incoming().reviewNote == null);

      allow update: if isAdmin() &&
        isValidId(requestId) &&
        isValidGovernanceChangeRequest(incoming()) &&
        existing().status == 'PENDING' &&
        incoming().status in ['APPROVED', 'REJECTED'] &&
        incoming().category == existing().category &&
        incoming().targetCollection == existing().targetCollection &&
        incoming().targetDocId == existing().targetDocId &&
        incoming().targetLabel == existing().targetLabel &&
        incoming().operation == existing().operation &&
        incoming().proposedPayload == existing().proposedPayload &&
        incoming().reason == existing().reason &&
        incoming().requestedByUid == existing().requestedByUid &&
        incoming().requestedByEmail == existing().requestedByEmail &&
        incoming().requestedByRole == existing().requestedByRole &&
        incoming().createdAt == existing().createdAt &&
        incoming().reviewedByUid == request.auth.uid &&
        incoming().reviewedByEmail.lower() == request.auth.token.email.lower() &&
        incoming().reviewedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedByUid', 'reviewedByEmail', 'reviewedAt', 'reviewNote']);

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Collection: /system_settings/{settingId}
    // -------------------------------------------------------------------------
    match /system_settings/{settingId} {
      allow get: if isVerifiedUser() && isValidId(settingId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(settingId) &&
        (
          (settingId == 'security' && isValidSecuritySettings(incoming())) ||
          (settingId == 'app_config' && isValidAppConfigSettings(incoming()))
        ) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedByEmail.lower() == request.auth.token.email.lower() &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(settingId) &&
        (
          (settingId == 'security' && isValidSecuritySettings(incoming())) ||
          (settingId == 'app_config' && isValidAppConfigSettings(incoming()))
        ) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedByEmail.lower() == request.auth.token.email.lower() &&
        incoming().updatedAt == request.time;

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Collection: /audit_logs/{logId} (Strictly Immutable Append-Only)
    // -------------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow get: if isStaffOrManager() && isValidId(logId);
      allow list: if isStaffOrManager();

      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().userEmail.lower() == request.auth.token.email.lower() &&
        incoming().timestamp == request.time;

      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Collection: /clients/{clientId}
    // -------------------------------------------------------------------------
    match /clients/{clientId} {
      allow get: if isVerifiedUser() &&
        isValidId(clientId) &&
        (isStaffOrManager() || isClientOwner(existing()));

      allow list: if isStaffOrManager() || (
        isVerifiedUser() &&
        (existing().ownerUid == request.auth.uid || existing().email == request.auth.token.email)
      );

      allow create: if isAdmin() && isValidId(clientId);

      allow update: if isVerifiedUser() &&
        isValidId(clientId) &&
        (
          isAdmin() ||
          (
            isManager() &&
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['lastReminderSent', 'reminderCount', 'latestReminderDraft', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['requiredDocuments', 'jobStatus', 'latestReminderDraft', 'updatedAt'])
            )
          ) ||
          (
            existing().isLocked == false &&
            incoming().isLocked == false &&
            isClientOwner(existing()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['requiredDocuments', 'jobStatus', 'latestReminderDraft', 'updatedAt'])
          )
        );

      allow delete: if isAdmin();

      // Subcollection: /clients/{clientId}/verifications/{verificationId}
      match /verifications/{verificationId} {
        allow get: if isVerifiedUser() &&
          isValidId(clientId) &&
          isValidId(verificationId) &&
          (
            isStaffOrManager() ||
            isClientOwner(get(/databases/$(database)/documents/clients/$(clientId)).data)
          );

        allow list: if isStaffOrManager() || (
          isVerifiedUser() &&
          (existing().clientOwnerUid == request.auth.uid || existing().clientEmail == request.auth.token.email)
        );

        allow create: if isVerifiedUser() &&
          isValidId(clientId) &&
          isValidId(verificationId) &&
          exists(/databases/$(database)/documents/clients/$(clientId)) &&
          (
            isStaffOrManager() ||
            isClientOwner(get(/databases/$(database)/documents/clients/$(clientId)).data)
          );

        allow update: if false;
        allow delete: if isAdmin();
      }

      // Subcollection: /clients/{clientId}/reminders/{reminderId}
      match /reminders/{reminderId} {
        allow get: if isVerifiedUser() &&
          isValidId(clientId) &&
          isValidId(reminderId) &&
          (
            isStaffOrManager() ||
            isClientOwner(get(/databases/$(database)/documents/clients/$(clientId)).data)
          );

        allow list: if isStaffOrManager() || (
          isVerifiedUser() &&
          (existing().clientOwnerUid == request.auth.uid || existing().clientEmail == request.auth.token.email)
        );

        allow create: if isVerifiedUser() &&
          isValidId(clientId) &&
          isValidId(reminderId) &&
          exists(/databases/$(database)/documents/clients/$(clientId)) &&
          isStaffOrManager();

        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
